# ==============================================================================
# Akriti OS (Codename: Chameleon) - Base Build Environment Configuration
# ==============================================================================

# OS & Distribution Identity
export DISTRO_NAME="Akriti OS"
export DISTRO_CODENAME="chameleon"
export DISTRO_VERSION="1.0.0"
export DISTRO_EDITION="Bharat Cyberdeck Edition"
export DISTRO_AUTHOR="Akriti OS Foundation / Bharat OS Initiative"
export DISTRO_HOMEPAGE="https://akritios.org"

# Upstream Foundation
export BASE_DISTRO="ubuntu"
export BASE_CODENAME="noble"
export BASE_VERSION="24.04"
export ARCH="amd64"
export KERNEL_FLAVOR="linux-generic-hwe-24.04"

# Default Target User & Hostname for Live Session
export LIVE_USER="akriti"
export LIVE_HOSTNAME="akriti-cyberdeck"
export LIVE_TIMEZONE="Asia/Kolkata"
export LIVE_LOCALE="en_IN.UTF-8"

# Upstream Base ISO Configuration
# Official Ubuntu 24.04 LTS (Noble) minimal XFCE desktop base
export BASE_ISO_NAME="xubuntu-24.04.5-minimal-amd64.iso"
export BASE_ISO_URL="https://cdimage.ubuntu.com/xubuntu/releases/24.04/release/xubuntu-24.04.5-minimal-amd64.iso"
export BASE_ISO_FALLBACK_URL="https://releases.ubuntu.com/24.04/ubuntu-24.04.5.1-desktop-amd64.iso"
export BASE_ISO_FALLBACK_NAME="ubuntu-24.04.5.1-desktop-amd64.iso"

# Output ISO Properties
export ISO_VOLID="Akriti_OS_Chameleon"
export ISO_APPLICATION="Akriti OS Live/Installer Media"
export ISO_FILENAME="akriti-os-chameleon-${DISTRO_VERSION}-${ARCH}.iso"

# SquashFS Compression Tuning
# Dev mode: fast turnaround with level 15 (2-3 min build)
# Prod mode: maximum compression level 19 with 1MB blocks for compact media distribution
export BUILD_MODE="${BUILD_MODE:-dev}"
export SQUASHFS_COMP="zstd"
export SQUASHFS_LEVEL_DEV="15"
export SQUASHFS_LEVEL_PROD="19"
export SQUASHFS_BLOCK_SIZE="1M"

# Directory Structure Paths (resolved relative to repository root)
SCRIPT_DIR_LOC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PROJECT_ROOT="$(cd "${SCRIPT_DIR_LOC}/.." && pwd)"
export BUILD_DIR="${PROJECT_ROOT}/build"
export CACHE_DIR="${PROJECT_ROOT}/cache"
export ROOTFS_DIR="${BUILD_DIR}/rootfs"
export ISO_EXTRACT_DIR="${BUILD_DIR}/iso_extract"
export OUTPUT_DIR="${BUILD_DIR}/output"
export CONFIG_DIR="${PROJECT_ROOT}/config"
export HOOKS_DIR="${PROJECT_ROOT}/hooks"
export OVERLAY_DIR="${PROJECT_ROOT}/overlay"
export ISO_OVERLAY_DIR="${PROJECT_ROOT}/iso-overlay"
export SCRIPTS_DIR="${PROJECT_ROOT}/scripts"
export CALAMARES_CONFIG_DIR="${CONFIG_DIR}/calamares"

# Color Codes for Terminal Output
export CLR_RESET="\033[0m"
export CLR_BOLD="\033[1m"
export CLR_RED="\033[31m"
export CLR_GREEN="\033[32m"
export CLR_YELLOW="\033[33m"
export CLR_BLUE="\033[34m"
export CLR_MAGENTA="\033[35m"
export CLR_CYAN="\033[36m"
export CLR_WHITE="\033[37m"
export CLR_COPPER="\033[38;5;209m"
export CLR_TEAL="\033[38;5;37m"
